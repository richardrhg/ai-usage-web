# 遠端部署請設定一組固定的隨機字串，確保容器重啟後仍可解密 SQLite 內的 OAuth Token
APP_SECRET_KEY=replace-with-a-long-random-secret

# 若掛在 HTTPS 反向代理後方建議設為 1
COOKIE_SECURE=0

# 是否開放新使用者註冊（私人團隊註冊完畢後可改為 0 鎖定）
ALLOW_REGISTRATION=1

# 背景輪詢、重抓冷卻與時序歷史保存設定
POLL_INTERVAL_SECONDS=120
REFRESH_COOLDOWN_SECONDS=30
PROACTIVE_REFRESH_BUFFER_SECONDS=300
HISTORY_MIN_INTERVAL_SECONDS=60
HISTORY_RETENTION_DAYS=30

# Google Gemini OAuth Client 設定（啟用 Gemini OAuth 綁定時必填）
GEMINI_OAUTH_CLIENT_ID=
GEMINI_OAUTH_CLIENT_SECRET=
